{
  "info": {
    "name": "Exchange Rate API (Auto Auth)",
    "description": "Coleccion configurada para usar Basic Auth a nivel de coleccion. No necesitas cargar auth manualmente en cada request.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "basic",
    "basic": [
      {
        "key": "username",
        "value": "{{username}}",
        "type": "string"
      },
      {
        "key": "password",
        "value": "{{password}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "username",
      "value": "admin"
    },
    {
      "key": "password",
      "value": "admin123"
    }
  ],
  "item": [
    {
      "name": "Health Check",
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/actuator/health"
        }
      }
    },
    {
      "name": "1. Convertir USD -> PEN",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/exchange/convert"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"from\": \"USD\",\n  \"to\": \"PEN\",\n  \"amount\": 100.0\n}"
        }
      }
    },
    {
      "name": "2. Convertir PEN -> USD",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/exchange/convert"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"from\": \"PEN\",\n  \"to\": \"USD\",\n  \"amount\": 500.0\n}"
        }
      }
    },
    {
      "name": "3. Historial de conversiones (rango de fechas)",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/exchange/history?from=2025-01-01&to=2026-12-31",
          "query": [
            {
              "key": "from",
              "value": "2025-01-01"
            },
            {
              "key": "to",
              "value": "2026-12-31"
            }
          ]
        }
      }
    },
    {
      "name": "4. Historial filtrado por moneda USD",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/exchange/history?from=2025-01-01&to=2026-12-31&currency=USD",
          "query": [
            {
              "key": "from",
              "value": "2025-01-01"
            },
            {
              "key": "to",
              "value": "2026-12-31"
            },
            {
              "key": "currency",
              "value": "USD"
            }
          ]
        }
      }
    },
    {
      "name": "5. Resumen total por tipo de moneda",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/exchange/summary"
        }
      }
    },
    {
      "name": "6. Sin autenticacion (debe retornar 401)",
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/exchange/summary"
        }
      }
    },
    {
      "name": "Swagger UI",
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/swagger-ui.html"
        }
      }
    }
  ]
}
